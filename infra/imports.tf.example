# Brownfield demo: bring a hand-made resource under IaCM management.
#
# 1. Create a firewall rule by hand, outside Terraform (after the dev workspace is provisioned):
#      gcloud compute firewall-rules create iacm-showcase-dev-manual-http \
#        --network=iacm-showcase-dev --allow=tcp:80 --source-ranges=10.0.0.0/8
# 2. Replace <PROJECT_ID> below, rename this file to imports.tf, commit, and run the provision pipeline.
#    The plan shows "1 to import" instead of "1 to add".
# 3. After a successful apply, delete the import block (the resource block stays).
#
# Terraform 1.5 requires the import id to be a literal string; expressions arrive in 1.6.

import {
  to = google_compute_firewall.manual_http
  id = "projects/<PROJECT_ID>/global/firewalls/iacm-showcase-dev-manual-http"
}

resource "google_compute_firewall" "manual_http" {
  name          = "iacm-showcase-dev-manual-http"
  network       = module.network.network_name
  source_ranges = ["10.0.0.0/8"]

  allow {
    protocol = "tcp"
    ports    = ["80"]
  }
}
